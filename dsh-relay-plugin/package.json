{
  "name": "dsh-relay-plugin",
  "version": "0.5.0",
  "description": "让手机连上这台电脑的 DSH：跟着 DSH 启动中转，挂了自动重启，配置在插件详情页里改",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib",
    "client.js",
    "locale",
    "relay.patch.yml",
    "README.md",
    "icon.png"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./relay.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
